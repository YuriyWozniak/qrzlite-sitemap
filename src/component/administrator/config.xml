<?xml version="1.0" encoding="UTF-8"?>
<config>
    <fieldset name="sitemap" label="COM_QRZLITESITEMAP_FIELDSET_SITEMAP">
        <field name="filename" type="text" default="sitemap" filter="cmd" required="true"
               label="COM_QRZLITESITEMAP_FIELD_FILENAME_LABEL" description="COM_QRZLITESITEMAP_FIELD_FILENAME_DESC"/>
        <field name="site_url" type="url" default="" filter="url" validate="url" scheme="http,https"
               label="COM_QRZLITESITEMAP_FIELD_SITE_URL_LABEL" description="COM_QRZLITESITEMAP_FIELD_SITE_URL_DESC"/>
        <field name="changefreq" type="list" default="weekly"
               label="COM_QRZLITESITEMAP_FIELD_CHANGEFREQ_LABEL" description="COM_QRZLITESITEMAP_FIELD_CHANGEFREQ_DESC">
            <option value="">COM_QRZLITESITEMAP_OPTION_NONE</option>
            <option value="always">COM_QRZLITESITEMAP_CHANGEFREQ_ALWAYS</option>
            <option value="hourly">COM_QRZLITESITEMAP_CHANGEFREQ_HOURLY</option>
            <option value="daily">COM_QRZLITESITEMAP_CHANGEFREQ_DAILY</option>
            <option value="weekly">COM_QRZLITESITEMAP_CHANGEFREQ_WEEKLY</option>
            <option value="monthly">COM_QRZLITESITEMAP_CHANGEFREQ_MONTHLY</option>
            <option value="yearly">COM_QRZLITESITEMAP_CHANGEFREQ_YEARLY</option>
            <option value="never">COM_QRZLITESITEMAP_CHANGEFREQ_NEVER</option>
        </field>
        <field name="priority" type="list" default="0.5"
               label="COM_QRZLITESITEMAP_FIELD_PRIORITY_LABEL" description="COM_QRZLITESITEMAP_FIELD_PRIORITY_DESC">
            <option value="">COM_QRZLITESITEMAP_OPTION_NONE</option>
            <option value="0.0">0.0</option>
            <option value="0.1">0.1</option>
            <option value="0.2">0.2</option>
            <option value="0.3">0.3</option>
            <option value="0.4">0.4</option>
            <option value="0.5">0.5</option>
            <option value="0.6">0.6</option>
            <option value="0.7">0.7</option>
            <option value="0.8">0.8</option>
            <option value="0.9">0.9</option>
            <option value="1.0">1.0</option>
        </field>
        <field name="xsl" type="radio" default="1" layout="joomla.form.field.radio.switcher" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_XSL_LABEL" description="COM_QRZLITESITEMAP_FIELD_XSL_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="split_limit" type="number" default="50000" min="100" max="50000" step="1" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_SPLIT_LIMIT_LABEL" description="COM_QRZLITESITEMAP_FIELD_SPLIT_LIMIT_DESC"/>
    </fieldset>

    <fieldset name="content" label="COM_QRZLITESITEMAP_FIELDSET_CONTENT">
        <field name="include_menu" type="radio" default="1" layout="joomla.form.field.radio.switcher" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_INCLUDE_MENU_LABEL">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="include_categories" type="radio" default="1" layout="joomla.form.field.radio.switcher" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_INCLUDE_CATEGORIES_LABEL">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="include_articles" type="radio" default="1" layout="joomla.form.field.radio.switcher" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_INCLUDE_ARTICLES_LABEL">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="include_archived" type="radio" default="0" layout="joomla.form.field.radio.switcher" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_INCLUDE_ARCHIVED_LABEL" description="COM_QRZLITESITEMAP_FIELD_INCLUDE_ARCHIVED_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="exclude" type="textarea" rows="5" filter="raw" default="/component/&#10;?view="
               label="COM_QRZLITESITEMAP_FIELD_EXCLUDE_LABEL" description="COM_QRZLITESITEMAP_FIELD_EXCLUDE_DESC"/>
    </fieldset>

    <fieldset name="html" label="COM_QRZLITESITEMAP_FIELDSET_HTML">
        <field name="html_limit" type="number" default="200" min="10" max="5000" step="1" filter="integer"
               label="COM_QRZLITESITEMAP_FIELD_HTML_LIMIT_LABEL" description="COM_QRZLITESITEMAP_FIELD_HTML_LIMIT_DESC"/>
    </fieldset>

    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules"
               component="com_qrzlitesitemap" section="component"/>
    </fieldset>
</config>
