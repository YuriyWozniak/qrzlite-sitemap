{
    "name": "yuriywozniak/qrzlite-sitemap",
    "description": "Lightweight XML and HTML sitemap for Joomla: menu items, categories and articles",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-xmlwriter": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.64",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "QrzLite\\Component\\Sitemap\\Administrator\\": "src/component/administrator/src/",
            "QrzLite\\Component\\Sitemap\\Site\\": "src/component/site/src/",
            "QrzLite\\Plugin\\Console\\Sitemap\\": "src/plugins/console/src/",
            "QrzLite\\Plugin\\Task\\Sitemap\\": "src/plugins/task/src/",
            "QrzLite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "joomla": "@php build/joomla.php",
        "lint": [
            "@lint:syntax",
            "@lint:style",
            "@lint:static"
        ],
        "lint:syntax": "parallel-lint src build tests",
        "lint:style": "php-cs-fixer check --diff",
        "lint:static": [
            "@joomla",
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "lint:html": [
            "@joomla",
            "@putenv QRZLITE_HTML_OUT=.cache/html",
            "phpunit --no-progress",
            "npm run lint"
        ],
        "fix": "php-cs-fixer fix",
        "test": [
            "@joomla",
            "phpunit"
        ],
        "test:performance": [
            "@joomla",
            "phpunit --testsuite performance"
        ],
        "benchmark": [
            "@joomla",
            "@putenv QRZLITE_BENCHMARK=1",
            "phpunit --testsuite performance --filter BenchmarkTest"
        ],
        "coverage": [
            "@joomla",
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-html .cache/coverage"
        ],
        "build": "@php build/build.php"
    },
    "scripts-descriptions": {
        "joomla": "Fetch the Joomla files the tests and the static analysis load (.cache/joomla)",
        "lint": "PHP syntax, code style and static analysis",
        "lint:html": "Render the layouts and stylesheets, then check their HTML and CSS (needs npm install)",
        "fix": "Fix the code style",
        "test": "Unit tests",
        "test:performance": "Performance tests: CPU time and memory of generation against budgets (PHP 8.2+)",
        "benchmark": "CPU time and memory of generation at 1,000 to 100,000 articles (.cache/benchmark.md)",
        "coverage": "Unit tests with a coverage report (needs pcov or Xdebug)",
        "build": "Build dist/pkg_qrzlitesitemap-<version>.zip"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.31"
        }
    }
}
