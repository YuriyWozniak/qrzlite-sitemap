{
    "name": "yuriywozniak/qrzlite-sitemap",
    "description": "Lightweight XML and HTML sitemap for Joomla: menu items, categories and articles",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-xmlwriter": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "QrzLite\\Component\\Sitemap\\Administrator\\": "src/component/administrator/src/",
            "QrzLite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "php build/build.php"
    },
    "config": {
        "sort-packages": true
    }
}
