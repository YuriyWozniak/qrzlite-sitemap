{
  "name": "qrzlite-sitemap",
  "private": true,
  "description": "HTML and CSS linters for QrzLite Sitemap (the PHP tooling is in composer.json)",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "html-validate .cache/html",
    "lint:css": "stylelint \"src/**/*.xsl\" \".cache/html/*.html\""
  },
  "devDependencies": {
    "html-validate": "^11.22.1",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
